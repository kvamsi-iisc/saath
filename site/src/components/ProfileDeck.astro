---
/**
 * Swipeable deck of example profile cards: what the photo gate and the AI
 * credibility check decide. Real photos (Unsplash) for verified cards, an
 * ffmpeg-smoothed real photo for the "heavily edited" card, StyleGAN faces
 * for rejected cards. See public/img/profiles/SOURCES.md.
 */
type Row = { k: string; v: string; s: 'ok' | 'warn' | 'bad'; who: 'models' | 'vendor' | 'AI' };
type Card = {
  id: string; type: 'verified' | 'flagged' | 'rejected'; img: string; name: string; age: number;
  meta: string; intent: 'Marriage' | 'Dating'; rows: Row[]; verdict: string;
};
const cards: Card[] = [
  { id: 'ananya', type: 'verified', img: '/img/profiles/real-1.jpg', name: 'Ananya R.', age: 29, meta: 'Product designer · Pune → Munich', intent: 'Marriage',
    rows: [
      { k: 'Photo', v: 'Camera-signed file, no generation or face-swap signal', s: 'ok', who: 'models' },
      { k: 'Live person', v: 'Liveness pass, selfie matches photos 0.98', s: 'ok', who: 'vendor' },
      { k: 'Government ID', v: 'Name and date of birth match the profile', s: 'ok', who: 'vendor' },
      { k: 'Story', v: '0 contradictions across 23 profile fields', s: 'ok', who: 'AI' },
    ], verdict: 'Live after 4 checks and 0 human minutes.' },
  { id: 'daniel', type: 'rejected', img: '/img/profiles/ai-1.jpg', name: '"Daniel K."', age: 33, meta: '"Investment advisor · Dubai"', intent: 'Dating',
    rows: [
      { k: 'Photo', v: 'Synthetic-face score 0.97, no camera credential', s: 'bad', who: 'models' },
      { k: 'History', v: 'Reverse-image search: this face exists nowhere else', s: 'warn', who: 'models' },
      { k: 'Live person', v: 'The live selfie is a different face', s: 'bad', who: 'vendor' },
      { k: 'Story', v: 'Bio paragraph shared with 14 other accounts this week', s: 'bad', who: 'AI' },
    ], verdict: 'Rejected before anyone saw it. The face was generated.' },
  { id: 'marcus', type: 'verified', img: '/img/profiles/real-2.jpg', name: 'Marcus T.', age: 34, meta: 'Civil engineer · Toronto', intent: 'Dating',
    rows: [
      { k: 'Photo', v: 'Three photos, consistent lighting and lens, no edits beyond crop', s: 'ok', who: 'models' },
      { k: 'Live person', v: 'Liveness pass, one account per face', s: 'ok', who: 'vendor' },
      { k: 'Government ID', v: 'Driving licence, name and age match', s: 'ok', who: 'vendor' },
      { k: 'Story', v: 'Job, city and timeline agree with each other', s: 'ok', who: 'AI' },
    ], verdict: 'Live. Verified in under five minutes.' },
  { id: 'sofia', type: 'flagged', img: '/img/profiles/edited-1.jpg', name: 'Sofia L.', age: 27, meta: 'Marketing lead · Lisbon', intent: 'Dating',
    rows: [
      { k: 'Photo', v: 'Heavy retouching: skin smoothing and reshaping detected', s: 'warn', who: 'models' },
      { k: 'Live person', v: 'Liveness pass, live face matches the unedited version', s: 'ok', who: 'vendor' },
      { k: 'Government ID', v: 'National ID, name and age match', s: 'ok', who: 'vendor' },
      { k: 'Story', v: 'No contradictions found', s: 'ok', who: 'AI' },
    ], verdict: 'Live, labelled "heavily edited". Asked to add one unedited photo.' },
  { id: 'priya', type: 'rejected', img: '/img/profiles/ai-2.jpg', name: '"Priya M."', age: 39, meta: '"Doctor · Singapore"', intent: 'Marriage',
    rows: [
      { k: 'Photo', v: 'Face-swap artefacts along the hairline and jaw', s: 'bad', who: 'models' },
      { k: 'Provenance', v: 'Edit history stripped from the file', s: 'warn', who: 'models' },
      { k: 'Live person', v: 'Live face does not match the photo', s: 'bad', who: 'vendor' },
      { k: 'Story', v: 'Age on ID differs from the profile by 9 years', s: 'bad', who: 'AI' },
    ], verdict: 'Rejected. Deepfake on a borrowed body, wrong age on top.' },
  { id: 'jonas', type: 'verified', img: '/img/profiles/real-3.jpg', name: 'Jonas W.', age: 36, meta: 'Teacher · Berlin', intent: 'Marriage',
    rows: [
      { k: 'Photo', v: 'No generation signal, no reuse elsewhere online', s: 'ok', who: 'models' },
      { k: 'Live person', v: 'Liveness pass, selfie match 0.97', s: 'ok', who: 'vendor' },
      { k: 'Government ID', v: 'Passport read via NFC, fields match', s: 'ok', who: 'vendor' },
      { k: 'Story', v: 'Divorce decree uploaded and consistent. Shown honestly.', s: 'ok', who: 'AI' },
    ], verdict: 'Live, with a verified "divorced" status.' },
  { id: 'alex', type: 'rejected', img: '/img/profiles/ai-3.jpg', name: '"Alex R."', age: 31, meta: '"Entrepreneur · London"', intent: 'Dating',
    rows: [
      { k: 'Photo', v: 'All three photos generated by the same model family', s: 'bad', who: 'models' },
      { k: 'Device', v: 'Phone shared with six other new accounts', s: 'bad', who: 'models' },
      { k: 'Live person', v: 'Liveness skipped after two failed attempts', s: 'bad', who: 'vendor' },
      { k: 'Story', v: 'Stated employer does not exist in any registry', s: 'warn', who: 'AI' },
    ], verdict: 'Rejected. Part of a six-account cluster, now all closed.' },
  { id: 'clara', type: 'verified', img: '/img/profiles/real-4.jpg', name: 'Clara N.', age: 26, meta: 'Nurse · Dublin', intent: 'Dating',
    rows: [
      { k: 'Photo', v: 'Light colour edit only, original camera credential kept', s: 'ok', who: 'models' },
      { k: 'Live person', v: 'Liveness pass, one account per face', s: 'ok', who: 'vendor' },
      { k: 'Government ID', v: 'Passport, name and age match', s: 'ok', who: 'vendor' },
      { k: 'Story', v: 'No contradictions found', s: 'ok', who: 'AI' },
    ], verdict: 'Live. Verified in three minutes.' },
];
const labels = { verified: 'Verified', flagged: 'Flagged', rejected: 'Rejected' };
---
<section class="section deck-section" id="profiles">
  <div class="wrap">
    <div class="header-row">
      <div>
        <p class="kicker" data-reveal>Inside {''}Saath</p>
        <h2 class="display h2" data-reveal style="--d:80ms">Every profile is <em>decided</em> before it is seen.</h2>
      </div>
      <p class="lede" data-reveal style="--d:160ms">
        Swipe through what the gate does. Real photos pass. Heavily edited ones are labelled and
        discouraged. Generated faces, face swaps and stolen pictures never reach another person.
      </p>
    </div>

    <div class="toolbar" data-reveal>
      <div class="chips" role="group" aria-label="Filter examples">
        <button class="chip" data-filter="all" aria-pressed="true">All</button>
        <button class="chip ok" data-filter="verified" aria-pressed="false">Verified</button>
        <button class="chip warn" data-filter="flagged" aria-pressed="false">Flagged</button>
        <button class="chip bad" data-filter="rejected" aria-pressed="false">Rejected</button>
      </div>
      <div class="ctrl">
        <span class="count mono" id="deck-count">1 / {cards.length}</span>
        <button class="arrow" id="deck-prev" aria-label="Previous profile"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M10 3 5 8l5 5"/></svg></button>
        <button class="arrow" id="deck-next" aria-label="Next profile"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="m6 3 5 5-5 5"/></svg></button>
      </div>
    </div>
  </div>

  <div class="track-wrap">
    <ul class="track" id="deck" tabindex="0" aria-label="Example profiles, swipe or use arrow keys">
      {cards.map((c) => (
        <li class="pcard" data-type={c.type} data-id={c.id}>
          <div class="photo">
            <img src={c.img} width="600" height="750" alt="" loading="lazy" decoding="async" />
            <span class={`ribbon ${c.type}`}>{labels[c.type]}</span>
            <span class="intent mono">{c.intent}</span>
          </div>
          <div class="body">
            <div class="ph">
              <p class="name">{c.name} <span class="muted">{c.age}</span></p>
              <p class="meta muted">{c.meta}</p>
            </div>
            <ul class="ledger">
              {c.rows.map((r, i) => (
                <li class="row" data-s={r.s} style={`--i:${i}`}>
                  <span class="mark" aria-hidden="true">
                    {r.s === 'ok' && <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.5 6.5 11.5 12.5 5"/></svg>}
                    {r.s === 'warn' && <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M8 4v5M8 12h.01"/></svg>}
                    {r.s === 'bad' && <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4.5 4.5l7 7M11.5 4.5l-7 7"/></svg>}
                  </span>
                  <span class="k">{r.k}</span>
                  <span class="v">{r.v}</span>
                  <span class="who mono">{r.who}</span>
                </li>
              ))}
            </ul>
            <p class={`verdict ${c.type}`}>{c.verdict}</p>
            <p class="foot mono">Example card. Not a user; {c.type === 'rejected' ? 'the face is AI-generated' : c.type === 'flagged' ? 'a real photo, filtered for this demo' : 'a real photo, used with licence'}.</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
  <p class="wrap hint mono">Swipe, drag, or use the arrow keys. Every status is explained to the applicant, and a human makes any final rejection.</p>
</section>

<style>
  .deck-section { overflow: hidden; }
  .toolbar { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
  .chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .chip { padding: 8px 14px; border-radius: 999px; border: 1px solid var(--line-strong); font-size: var(--t-sm); display: inline-flex; align-items: center; gap: 8px; transition: all .2s var(--ease); }
  .chip::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--ink-4); }
  .chip.ok::before { background: var(--ok); } .chip.warn::before { background: var(--warn); } .chip.bad::before { background: var(--bad); }
  .chip:hover { border-color: var(--ink); }
  .chip[aria-pressed='true'] { background: var(--green); color: var(--paper); border-color: var(--green); }
  .chip[aria-pressed='true']::before { background: var(--paper); }
  .ctrl { display: flex; align-items: center; gap: 8px; }
  .count { color: var(--ink-3); font-size: var(--t-xs); margin-right: 6px; min-width: 4ch; }
  .arrow { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--line-strong); display: grid; place-items: center; transition: all .2s var(--ease); }
  .arrow:hover { background: var(--green); color: var(--paper); border-color: var(--green); }
  .arrow svg { width: 16px; height: 16px; }

  .track-wrap { position: relative; }
  .track {
    --pad: max(var(--gutter), calc((100vw - var(--max)) / 2));
    --cw: min(86vw, 372px);
    display: flex; gap: 20px; overflow-x: auto; overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory; scroll-padding-inline-start: var(--pad); scrollbar-width: none;
    padding: 8px calc(100vw - var(--pad) - var(--cw)) 24px var(--pad);
    cursor: grab;
  }
  .track:active { cursor: grabbing; }
  .track::-webkit-scrollbar { display: none; }
  .track.drag { scroll-snap-type: none; }
  .track:focus-visible { outline-offset: -3px; }
  .pcard {
    flex: 0 0 var(--cw); scroll-snap-align: start;
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius-lg);
    overflow: hidden; box-shadow: var(--shadow); display: grid; grid-template-rows: auto 1fr;
    transform: scale(.96); opacity: .88; transition: transform .5s var(--ease), opacity .4s;
  }
  .pcard.active { transform: none; opacity: 1; }
  .pcard[hidden] { display: none; }
  .photo { position: relative; aspect-ratio: 4 / 3.4; overflow: hidden; background: var(--paper-2); }
  .photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; filter: saturate(.96); }
  .pcard[data-type='rejected'] .photo img { filter: saturate(.7); }
  .pcard[data-type='rejected'] .photo::after {
    content: ''; position: absolute; inset: 0;
    background: repeating-linear-gradient(135deg, transparent 0 14px, rgba(183,75,49,.18) 14px 16px);
    opacity: 0; transition: opacity .6s;
  }
  .pcard[data-type='rejected'].done .photo::after { opacity: 1; }
  .ribbon {
    position: absolute; top: 14px; left: 14px; padding: 6px 11px; border-radius: 999px;
    font-size: 11px; letter-spacing: .1em; text-transform: uppercase; font-weight: 600;
    background: var(--card); color: var(--ink); border: 1px solid var(--line);
    transform: translateY(-6px); opacity: 0; transition: transform .5s var(--ease), opacity .4s;
  }
  .pcard.done .ribbon { opacity: 1; transform: none; }
  .ribbon.verified { background: var(--ok); color: #fff; border-color: var(--ok); }
  .ribbon.flagged { background: var(--warn); color: #fff; border-color: var(--warn); }
  .ribbon.rejected { background: var(--bad); color: #fff; border-color: var(--bad); }
  .intent { position: absolute; top: 14px; right: 14px; padding: 5px 9px; border-radius: 999px; background: rgba(32,53,40,.55); color: #fff; font-size: 10px; letter-spacing: .08em; text-transform: uppercase; backdrop-filter: blur(6px); }
  .body { padding: 18px 18px 16px; display: grid; align-content: start; gap: 10px; }
  .name { font-weight: 600; font-size: 1.05rem; letter-spacing: -0.01em; }
  .meta { font-size: var(--t-sm); }
  .ledger { display: grid; gap: 2px; border-top: 1px solid var(--line); padding-top: 8px; }
  .row {
    display: grid; grid-template-columns: 20px 78px 1fr auto; gap: 8px; align-items: start;
    padding: 7px 4px; border-radius: 8px; font-size: 12.5px; line-height: 1.35;
    opacity: .3; transition: opacity .4s var(--ease), background .4s;
  }
  .row.done { opacity: 1; }
  .mark { width: 20px; height: 20px; border-radius: 50%; border: 1.5px solid var(--line-strong); display: grid; place-items: center; color: transparent; transition: all .35s var(--ease); margin-top: 1px; }
  .mark svg { width: 11px; height: 11px; }
  .row.done[data-s='ok'] .mark { background: var(--ok); border-color: var(--ok); color: #fff; }
  .row.done[data-s='warn'] .mark { background: var(--warn); border-color: var(--warn); color: #fff; }
  .row.done[data-s='bad'] .mark { background: var(--bad); border-color: var(--bad); color: #fff; }
  .row.done[data-s='bad'] { background: var(--bad-soft); }
  .row.done[data-s='warn'] { background: var(--warn-soft); }
  .k { font-weight: 600; color: var(--ink); }
  .v { color: var(--ink-2); text-wrap: pretty; }
  .who { font-size: 9.5px; letter-spacing: .06em; text-transform: uppercase; color: var(--ink-4); margin-top: 2px; }
  .verdict { font-family: var(--font-display); font-size: 1.15rem; line-height: 1.15; padding-top: 10px; border-top: 1px solid var(--line); opacity: 0; transition: opacity .5s; }
  .pcard.done .verdict { opacity: 1; }
  .verdict.verified { color: var(--ok); } .verdict.flagged { color: var(--warn); } .verdict.rejected { color: var(--bad); }
  .foot { font-size: 10.5px; color: var(--ink-4); }
  .hint { display: block; margin-top: 8px; font-size: var(--t-xs); color: var(--ink-4); }
  @media (max-width: 480px) {
    .row { grid-template-columns: 20px 1fr auto; }
    .row .mark, .row .k, .row .who { grid-row: 1; }
    .row .k { grid-column: 2; }
    .row .who { grid-column: 3; }
    .row .v { grid-column: 2 / -1; grid-row: 2; margin-top: -2px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pcard, .row, .ribbon, .verdict { opacity: 1; transform: none; transition: none; }
    .row[data-s='ok'] .mark { background: var(--ok); border-color: var(--ok); color: #fff; }
    .row[data-s='warn'] .mark { background: var(--warn); border-color: var(--warn); color: #fff; }
    .row[data-s='bad'] .mark { background: var(--bad); border-color: var(--bad); color: #fff; }
  }
</style>
