---
import { SITE } from '../config/site';
---
<section class="hero">
  <div class="wrap hero-grid">
    <div class="copy">
      <p class="kicker" data-reveal>A new chapter for matrimony and dating</p>
      <h1 class="display h1" data-reveal style="--d:80ms">
        <span>A real face.</span>
        <span>A real story.</span>
        <em>A real beginning.</em>
      </h1>
      <p class="lede" data-reveal style="--d:160ms">
        Filters flatter. Generators invent. Deepfakes borrow someone else's face. On {SITE.name},
        our own detection models screen every photo for AI generation, face swaps, heavy editing
        and stolen pictures before a profile exists. Then AI reads the whole story for credibility
        and matches you on what holds up in real life. Whether you are here for marriage or for
        dating, the person on the other side is who they say they are.
      </p>
      <div class="cta" data-reveal style="--d:240ms">
        <a href="#waitlist" class="btn btn-primary">Join the waitlist
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12 12 4M6 4h6v6"/></svg>
        </a>
        <a href="#trust" class="btn btn-ghost">See how verification works
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 3v10M4 9l4 4 4-4"/></svg>
        </a>
      </div>
      <div class="building" data-reveal style="--d:320ms">
        <span class="ring" aria-hidden="true"></span>
        <div>
          <p class="b1">Good things take intention. We're building.</p>
          <p class="b2 muted">iOS &amp; Android apps planned · Waitlist members get the first invites</p>
        </div>
      </div>
    </div>

    <figure class="art" data-reveal style="--d:160ms">
      <div class="frame">
        <img src="/img/hero-couple.jpg" width="1000" height="820" alt="Illustration of two people talking over coffee on a sunlit balcony" fetchpriority="high" decoding="async" />
        <p class="corner tl">Less guesswork.<br/>More possibility.</p>
        <p class="corner tr">01 · A beginning</p>
      </div>
      <figcaption class="caption">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12 12 4M6 4h6v6"/></svg>
        <p class="display">A life together starts<br/>with an honest conversation.</p>
        <span class="seal display"><small>made for</small>real life</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero { padding-block: clamp(48px, 7vw, 104px) clamp(56px, 8vw, 110px); position: relative; overflow: hidden; }
  .hero-grid { position: relative; display: grid; gap: clamp(36px, 5vw, 72px); align-items: center; }
  @media (min-width: 960px) { .hero-grid { grid-template-columns: 11fr 9fr; } }
  .copy { --stack: 28px; }
  .copy > * + * { margin-top: var(--stack); }
  .h1 { display: grid; }
  .h1 span, .h1 em { display: block; }
  .h1 em { font-style: italic; }
  .lede { max-width: 46ch; font-size: clamp(1.02rem, 0.95rem + 0.35vw, 1.2rem); }
  .cta { display: flex; flex-wrap: wrap; gap: 14px 28px; align-items: center; }

  .building { display: flex; gap: 14px; align-items: flex-start; margin-top: 44px; }
  .ring { width: 22px; height: 22px; border-radius: 50%; border: 1.5px dashed var(--accent); flex: none; margin-top: 2px; animation: spin 14s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .b1 { font-weight: 500; font-size: var(--t-sm); }
  .b2 { font-size: var(--t-sm); margin-top: 2px; }

  /* --- illustration with arched top and overlapping caption --- */
  .art { position: relative; margin: 0; }
  .frame {
    position: relative; overflow: hidden;
    border-radius: 46% 46% 10px 10px / 18% 18% 10px 10px;
    background: var(--paper-2); box-shadow: var(--shadow);
  }
  .frame img { width: 100%; height: auto; aspect-ratio: 1000 / 820; object-fit: cover; }
  .corner { position: absolute; top: 34px; font-size: 10.5px; letter-spacing: .14em; text-transform: uppercase; color: var(--ink-2); line-height: 1.5; }
  .corner.tl { left: 64px; }
  .corner.tr { right: 64px; }
  .caption {
    position: relative; z-index: 1;
    margin: -56px 24px 0; padding: 18px 22px;
    display: grid; grid-template-columns: 20px 1fr auto; gap: 16px; align-items: center;
    background: var(--card); border: 1px solid var(--line); box-shadow: var(--shadow);
  }
  .caption > svg { width: 20px; height: 20px; color: var(--accent); }
  .caption p { font-size: clamp(1.15rem, 1rem + 0.7vw, 1.55rem); line-height: 1.15; }
  .seal {
    width: 84px; height: 84px; border-radius: 50%; border: 1px solid var(--ink-3);
    display: grid; place-content: center; text-align: center; font-size: 1rem; line-height: 1;
    color: var(--ink); transform: rotate(-8deg);
  }
  .seal small { display: block; font-family: var(--font-sans); font-size: 9px; letter-spacing: .04em; color: var(--ink-3); margin-bottom: 4px; }
  @media (max-width: 560px) {
    .caption { margin-inline: 12px; grid-template-columns: 16px 1fr; padding: 14px 16px; }
    .caption > svg { width: 16px; height: 16px; }
    .seal { display: none; }
    .corner.tr { display: none; }
    .building { margin-top: 28px; }
  }
  @media (prefers-reduced-motion: reduce) { .ring { animation: none; } }
</style>
